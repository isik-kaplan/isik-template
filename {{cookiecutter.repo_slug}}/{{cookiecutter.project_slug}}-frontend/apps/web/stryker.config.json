{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.mts" },
  "reporters": ["progress", "html", "json", "accounted"],
  "appendPlugins": ["../../packages/mutation-check/stryker-accounted-reporter.mjs"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/index.ts",
    "!src/**/*.d.ts",
    "!src/__tests__/**",
    "!src/lib/queryGrammar.generated.ts"
  ],
  "thresholds": { "high": 100, "low": 90, "break": null },
  "timeoutMS": 15000,
  "timeoutFactor": 3,
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
