{
  "name": "{{ cookiecutter.repo_slug }}-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@{{ cookiecutter.repo_slug }}/api --workspace=@{{ cookiecutter.repo_slug }}/auth-api",
    "build": "npm run build --workspace=web",
    "dev": "npm run dev --workspace=web",
    "lint:eslint": "eslint .",
    "lint:types": "npm run lint:types --workspaces --if-present",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:prettier",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "typescript": "^5.6.0"
  }
}
