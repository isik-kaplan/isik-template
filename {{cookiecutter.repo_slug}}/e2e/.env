# Run `docker compose ...` FROM THIS DIRECTORY; Compose reads the project name and files from here.
# Tracked on purpose: nothing in it is secret. The separate project name keeps a dev stack untouched.
COMPOSE_PROJECT_NAME={{ cookiecutter.repo_slug }}-e2e
# Change when another network holds 172.30.0.0/24 ("Pool overlaps with other one on this space").
#E2E_SUBNET_PREFIX=172.30.0
COMPOSE_FILE=../docker-compose.yml:docker-compose.e2e.yml:docker-compose.mailpit-for-e2e.yml:docker-compose.authentik-for-e2e.yml

# Overrides on top of the root .env from here down. Compose also interpolates ${...} from this file,
# which is why POSTGRES_DB duplicates {{ cookiecutter.config_prefix }}__DB__NAME.

# ---- Database: e2e gets its OWN Postgres, not the dev one -----------------------------------
# Specs never tear down their users; COMPOSE_PROJECT_NAME gives the database its own volume.
{{ cookiecutter.config_prefix }}__DB__NAME={{ cookiecutter.project_slug }}_e2e
POSTGRES_DB={{ cookiecutter.project_slug }}_e2e

# ---- Email: smtp, routed to mailpit, without touching DEBUG ---------------------------------
# Not DEBUG=false: Secure cookies would break on a stack with no TLS termination.
{{ cookiecutter.config_prefix }}__EMAIL__BACKEND=smtp
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__HOST=mailpit
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__PORT=1025
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__USE_TLS=false

# ---- Rate limits: off -------------------------------------------------------------------------
# All of them: they outlive a test, so one spec's traffic would fail an unrelated later spec.
{{ cookiecutter.config_prefix }}__RATE_LIMITS__ENABLED=false

# ---- OIDC social login: a real, disposable Authentik instance --------------------------------
# Must match authentik-blueprints/oidc-test-idp.yaml. Empty runs the suite without social login.
{{ cookiecutter.config_prefix }}__SOCIAL_LOGIN__PROVIDERS=openid_connect
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__CLIENT_ID=e2e-oidc-client-id
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__CLIENT_SECRET=e2e-oidc-client-secret-not-a-real-secret
# Must match the blueprint's redirect_uris.
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__PROVIDER_ID=authentik
# :9000: Authentik is not behind this app's nginx.
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__SERVER_URL=http://authentik.{{ cookiecutter.domain }}:9000/application/o/e2e-oidc-test/

# ---- OAuth provider: on, so the "Sign in with" specs can register an application ---------------
# A throwaway key that signs nothing outside this disposable stack.
{{ cookiecutter.config_prefix }}__OAUTH_PROVIDER__MODE=approval
