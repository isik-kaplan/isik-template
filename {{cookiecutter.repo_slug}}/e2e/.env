# Everything the e2e stack needs, in one file that Compose picks up on its own. Run it with a
# plain `docker compose ...` FROM THIS DIRECTORY - COMPOSE_PROJECT_NAME and COMPOSE_FILE below are
# read straight out of here, so no --project-name, --env-file or -f flags are ever typed by hand.
#
# Tracked deliberately: this is shared setup, not a developer's own secrets, and the suite is
# unrunnable without it. Nothing in it is sensitive.
#
# The separate project name is what lets this run *beside* a developer's own stack instead of
# recreating its containers - under one project name it would repoint a running dev stack at the
# e2e database and dnsmasq resolver.
COMPOSE_PROJECT_NAME={{ cookiecutter.repo_slug }}-e2e
COMPOSE_FILE=../docker-compose.yml:docker-compose.e2e.yml:docker-compose.mailpit-for-e2e.yml:docker-compose.authentik-for-e2e.yml

# Every environment difference the e2e stack needs from normal local dev, from here down. Applied
# by docker-compose.e2e.yml as a second env_file (`env_file: [e2e/.env]`, path relative to the
# project directory - the repo root, not this file's own directory - see that file's comment) on
# top of the root .env - later env_file entries win on key conflicts. Also used by Compose itself
# for ${...} interpolation in the compose files, since this is the .env in the directory
# `docker compose` is invoked from - which is why POSTGRES_DB below is needed even though it
# duplicates {{ cookiecutter.config_prefix }}__DB__NAME: docker-compose.yml's
# `environment: POSTGRES_DB: ${...}` block is resolved by Compose's interpolation, not by the
# container's own env_file loading.
#
# Not secrets - every value below is a local-dev-only default for a stack that never leaves a
# developer's machine or CI runner.

# ---- Database: e2e gets its OWN Postgres, not the dev one -----------------------------------
# Specs create real users through real signup flows and never tear them down, so sharing the dev
# database would drift local data on every run. Isolation comes from COMPOSE_PROJECT_NAME above:
# the same `database` service gets its own {{ cookiecutter.repo_slug }}-e2e_postgres_data volume
# under this project name.
{{ cookiecutter.config_prefix }}__DB__NAME={{ cookiecutter.project_slug }}_e2e
POSTGRES_DB={{ cookiecutter.project_slug }}_e2e

# ---- Email: smtp, routed to mailpit, without touching DEBUG ---------------------------------
# Forces the smtp backend independently of DEBUG - see EMAIL__BACKEND in .env.example for why
# this can't just be DEBUG=false (Secure cookies would break on a stack with no TLS termination).
{{ cookiecutter.config_prefix }}__EMAIL__BACKEND=smtp
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__HOST=mailpit
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__PORT=1025
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__USE_TLS=false

# ---- Rate limits: off -------------------------------------------------------------------------
# allauth's rate limits are keyed by ip and by user and outlive any single test - the suite signs
# up, logs in, and changes passwords far faster than any human, and one spec's traffic would
# otherwise start failing an unrelated later spec. Real deployments keep allauth's own defaults.
{{ cookiecutter.config_prefix }}__ACCOUNTS__RATE_LIMITS_ENABLED=false

# ---- OIDC social login: a real, disposable Authentik instance --------------------------------
# Fixed dev-only values, matching e2e/authentik-blueprints/oidc-test-idp.yaml exactly - that
# blueprint is what actually creates this client on Authentik's side, applied automatically on
# boot (see docker-compose.authentik-for-e2e.yml).
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__CLIENT_ID=e2e-oidc-client-id
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__CLIENT_SECRET=e2e-oidc-client-secret-not-a-real-secret
# Must match the redirect_uris registered in the blueprint exactly - see that file's own comment.
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__PROVIDER_ID=authentik
# The application slug (e2e-oidc-test) in the path is Authentik's own OIDC issuer convention -
# .well-known/openid-configuration is resolved from this by allauth itself (see
# OpenIDConnectProvider.wk_server_url in django-allauth), not appended here. :9000 is required -
# Authentik listens there directly (docker-compose.authentik-for-e2e.yml), not behind this app's
# own nginx like every other subdomain.
{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__SERVER_URL=http://authentik.{{ cookiecutter.domain }}:9000/application/o/e2e-oidc-test/
