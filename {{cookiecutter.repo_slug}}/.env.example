# Every variable below is read somewhere in this project (backend, frontend, or docker-compose).
# Required: no working default exists - the app/stack won't start without a real value.
# Missing Default: what the app falls back to if this var is left unset entirely.
# Required and Missing Default are mutually exclusive per variable.
#
# Missing Default vars are written commented out, and must stay that way. `KEY=` sets an empty
# string rather than leaving KEY unset, and the config layer only falls back when a var is absent -
# so an empty value skips the default and reaches the caster, which either rejects it outright
# (boolean) or hands the app "" where it documented a real fallback.
#
# Required vars below carry real, working local-dev values already - this file is meant to be
# copied straight to .env and just work, the same way {{ cookiecutter.project_name }} itself was
# generated with a real answer for every prompt that has no sensible default.

# Used-By: backend (settings.py)
# Purpose: Django DEBUG flag - also gates the default email backend (console if true, smtp if false)
# Options: true, false
# Required
{{ cookiecutter.config_prefix }}__DEBUG=true

# Used-By: backend (settings.py)
# Purpose: Django SECRET_KEY
# Options: -
# Required
{{ cookiecutter.config_prefix }}__SECRET_KEY=local-insecure-secret-key-change-in-real-deployments

# Used-By: docker-compose.yml (backend's network aliases), backend (settings.py -> ALLOWED_HOSTS,
#   django-hosts PARENT_HOST), server (nginx server_name)
# Purpose: the domain this app is served on - api./admin./auth. subdomains route to the backend,
#   the bare domain routes to the frontend
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DOMAIN={{ cookiecutter.domain }}

# Used-By: docker compose itself, read before anything else - prefixes every container/volume/
#   network name so this stack never collides with another compose project on the same machine
# Purpose: this stack's Compose project name
# Options: -
# Required
COMPOSE_PROJECT_NAME={{ cookiecutter.repo_slug }}

# Used-By: docker-compose.yml (server service)
# Purpose: host port nginx publishes on
# Options: -
# Missing Default: 80
#{{ cookiecutter.config_prefix }}__HTTP_PORT=

# Used-By: backend (settings.py), database service (POSTGRES_DB)
# Purpose: Postgres/ParadeDB database name
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DB__NAME={{ cookiecutter.project_slug }}

# Used-By: backend (settings.py), database service (POSTGRES_USER), healthcheck (pg_isready -U)
# Purpose: Postgres/ParadeDB user
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DB__USER={{ cookiecutter.project_slug }}

# Used-By: backend (settings.py), database service (POSTGRES_PASSWORD)
# Purpose: Postgres/ParadeDB password - internal-network-only, never reachable from outside Docker
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DB__PASSWORD={{ cookiecutter.project_slug }}

# Used-By: backend (settings.py)
# Purpose: Postgres/ParadeDB host
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DB__HOST=database

# Used-By: backend (settings.py)
# Purpose: Postgres/ParadeDB port
# Options: -
# Required
{{ cookiecutter.config_prefix }}__DB__PORT=5432

# Used-By: backend (settings.py), broker service (RABBITMQ_DEFAULT_USER)
# Purpose: RabbitMQ/AMQP user
# Options: -
# Required
{{ cookiecutter.config_prefix }}__BROKER__USER={{ cookiecutter.project_slug }}

# Used-By: backend (settings.py), broker service (RABBITMQ_DEFAULT_PASS)
# Purpose: RabbitMQ/AMQP password - internal-network-only, never reachable from outside Docker
# Options: -
# Required
{{ cookiecutter.config_prefix }}__BROKER__PASSWORD={{ cookiecutter.project_slug }}

# Used-By: backend (settings.py)
# Purpose: RabbitMQ/AMQP host
# Options: -
# Required
{{ cookiecutter.config_prefix }}__BROKER__HOST=broker

# Used-By: backend (settings.py)
# Purpose: RabbitMQ/AMQP port
# Options: -
# Required
{{ cookiecutter.config_prefix }}__BROKER__PORT=5672

# Used-By: apps.users.management.commands.setup (entrypoint.sh runs it on every backend start)
# Purpose: username for the seeded local-dev superuser, created once if no superuser exists yet
# Options: -
# Required
{{ cookiecutter.config_prefix }}__SETUP__SUPERUSER__USERNAME=admin

# Used-By: apps.users.management.commands.setup
# Purpose: email for the seeded local-dev superuser
# Options: -
# Required
{{ cookiecutter.config_prefix }}__SETUP__SUPERUSER__EMAIL=admin@{{ cookiecutter.domain }}

# Used-By: apps.users.management.commands.setup
# Purpose: password for the seeded local-dev superuser
# Options: -
# Required
{{ cookiecutter.config_prefix }}__SETUP__SUPERUSER__PASSWORD=admin-change-me

# Used-By: backend (settings.py) - DEBUG picks console vs smtp on its own; this only exists to
#   force smtp *without* flipping DEBUG (e2e needs mailpit but must keep non-Secure cookies, which
#   DEBUG=false would break on a stack with no TLS termination)
# Purpose: Django email backend override
# Options: console, smtp
# Missing Default: (empty - falls back to console if DEBUG else smtp)
#{{ cookiecutter.config_prefix }}__EMAIL__BACKEND=

# Used-By: backend (settings.py)
# Purpose: SMTP host - only read when DEBUG is false (console backend is used under DEBUG instead)
# Options: -
# Required
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__HOST=localhost

# Used-By: backend (settings.py)
# Purpose: SMTP port
# Options: -
# Required
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__PORT=587

# Used-By: backend (settings.py)
# Purpose: SMTP username - may be an empty string for an SMTP server with no auth (e.g. Mailpit)
# Options: -
# Required
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__USER=

# Used-By: backend (settings.py)
# Purpose: SMTP password - may be an empty string for an SMTP server with no auth (e.g. Mailpit)
# Options: -
# Required
{{ cookiecutter.config_prefix }}__EMAIL__SMTP__PASSWORD=

# Used-By: backend (settings.py)
# Purpose: whether the SMTP connection uses TLS - Mailpit's own SMTP listener doesn't speak it
# Options: true, false
# Missing Default: true
#{{ cookiecutter.config_prefix }}__EMAIL__SMTP__USE_TLS=

# Used-By: backend (settings.py, apps.users.adapters)
# Purpose: default "from" address for outgoing email
# Options: -
# Required
{{ cookiecutter.config_prefix }}__EMAIL__DEFAULT_FROM=noreply@{{ cookiecutter.domain }}
{%- if cookiecutter.social_login_providers.strip() == "all" %}

# Used-By: backend (settings.py) - one CLIENT_ID/CLIENT_SECRET pair per provider you actually
#   configure. "all" was selected, so this isn't enumerated here (that's ~90 pairs) - add
#   {{ cookiecutter.config_prefix }}__OAUTH__<PROVIDER>__CLIENT_ID and ...__CLIENT_SECRET for each
#   provider you turn on, where <PROVIDER> is its allauth provider id, upper-cased
#   (e.g. GOOGLE, GITHUB, MICROSOFT). A provider with no such pair configured is installed but
#   inert - allauth just won't have credentials to complete its flow.
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
{%- elif cookiecutter.social_login_providers.strip() %}
{%- for provider in cookiecutter.social_login_providers.split(',') %}

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client ID for the "{{ provider.strip() }}" social login provider - the app starts
#   fine without it, that provider's login button just won't complete its flow until configured
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#{{ cookiecutter.config_prefix }}__OAUTH__{{ provider.strip().upper() }}__CLIENT_ID=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: OAuth client secret for the "{{ provider.strip() }}" social login provider
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#{{ cookiecutter.config_prefix }}__OAUTH__{{ provider.strip().upper() }}__CLIENT_SECRET=
{%- if provider.strip() == "openid_connect" %}

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: base URL of the OpenID Connect issuer (its /.well-known/openid-configuration is
#   resolved from this) - openid_connect is generic, unlike every other provider here, so it has
#   no fixed issuer of its own to fall back on
# Options: -
# Missing Default: (unset - that provider's login button won't work until configured)
#{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__SERVER_URL=

# Used-By: backend (settings.py -> SOCIALACCOUNT_PROVIDERS)
# Purpose: names this specific OpenID Connect instance - openid_connect supports multiple distinct
#   issuers side by side, so unlike every other provider here its redirect/callback URL is built
#   from this value, not a fixed slug (/v0/provider-callback/oidc/<this>/login/callback/) - must
#   match whatever redirect_uri is registered on the IdP's side exactly
# Options: -
# Missing Default: openid_connect
#{{ cookiecutter.config_prefix }}__OAUTH__OPENID_CONNECT__PROVIDER_ID=
{%- endif %}
{%- endfor %}
{%- endif %}

# Used-By: frontend build only (Docker build arg, inlined into the browser bundle by `next build`
#   - no runtime env can switch the browser SDK on afterwards)
# Purpose: Sentry DSN for browser-side errors - unset disables it
# Options: -
# Missing Default: (unset - Sentry disabled)
#NEXT_PUBLIC_SENTRY_DSN=

# Used-By: backend (settings.py) - sentry_sdk.init() is only called at all when this is truthy
# Purpose: Sentry DSN for backend errors - unset disables Sentry entirely
# Options: -
# Missing Default: (unset - Sentry disabled)
#{{ cookiecutter.config_prefix }}__SENTRY__DSN=
