{% raw -%}
{% extends "account/email/base/base.html" %}
{% load i18n %}

{% block content %}
        <mj-text>{% blocktrans %}Signing in to {{ site_name }} is restricted for the moment, so you have been signed out.{% endblocktrans %}</mj-text>
        <mj-text>{% blocktrans %}Nothing is wrong with your account. You will be able to sign in again once signing in reopens.{% endblocktrans %}</mj-text>
{% endblock content %}
{%- endraw %}
